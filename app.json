{
  "configVersion": "v3",
  "app": {
    "appId": 24183,
    "appName": "Balance Nav",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "0.1.0"
    },
    "icon": "icon.png",
    "vender": "personal",
    "description": "OpenStreetMap navigation for Amazfit Balance"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.geolocation",
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.0.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "gt": {
      "module": {
        "page": {
          "pages": [
            "page/nav/index.page"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Balance Nav"
    }
  },
  "defaultLanguage": "en-US",
  "debug": false
}
